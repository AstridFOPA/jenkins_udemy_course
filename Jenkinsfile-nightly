pipeline {
    agent any

    stages {
        /* this stage run a Dockerfile inside the CI 
        the -f after the build command is to specify where the specific Dockerfile is located
        it can also be use to define a different name that we have gave to our Dockerfile */
        stage('Docker'){
            steps {
                sh 'docker build -f CI/Dockerfile -t my-playwright .'
                sh 'docker build -f CI/Dockerfile-aws-cli -t my-aws-cli .'    
            }
        }
    }
}
